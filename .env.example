# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather (required)
TELEGRAM_BOT_TOKEN=replace-with-bot-token

# OpenAI-compatible Chat Completions API (all required)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=replace-with-model-name

# Max wait for one LLM request including SDK retries, Go duration (optional, default 30s)
LLM_TIMEOUT=30s

# PostgreSQL credentials used by the postgres service in docker-compose
POSTGRES_USER=expenses
POSTGRES_PASSWORD=replace-with-db-password
POSTGRES_DB=expenses

# Connection string for the app (required); host "postgres" is the compose service name
DATABASE_DSN=postgres://expenses:replace-with-db-password@postgres:5432/expenses?sslmode=disable

# REST API port (optional, default 8080)
HTTP_PORT=8080

# Host port of the web panel served by nginx (optional, default 3000)
WEB_PORT=3000

# Comma-separated browser origins allowed to call the REST API (optional, default http://localhost:5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Log level: debug, info, warn, error (optional, default info)
LOG_LEVEL=info

# Time zone for "today/yesterday/this month" in the bot (optional; container default is UTC)
TZ=Europe/Moscow
